<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lista_de_Tarefas.MainPage">

    <Grid ColumnSpacing="10" RowSpacing="20" HorizontalOptions="Fill" Padding="20,30,20,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <Label Grid.ColumnSpan="3" Grid.Row="0" Text="Minhas Tarefas" FontAttributes="Bold" FontSize="30" HorizontalOptions="Center"/>
        <Entry Grid.ColumnSpan="2" Grid.Row="1" x:Name="entryTarefa" Placeholder="Adicione uma tarefa"/>
        <Button Grid.Column="2" Grid.Row="1" x:Name="btAdicionar" Text="Adicionar" Clicked="btAdicionar_Clicked"/>
        <ScrollView Grid.ColumnSpan="3" Grid.Row="2">
            <VerticalStackLayout x:Name="listaTarefas">
                <!--Adiciona tarefas pelo back-end-->
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.ColumnSpan="3" Grid.Row="4" x:Name="lbContagem" Text="0 de 0 tarefas concluídas" HorizontalOptions="Center"/>
    </Grid>

</ContentPage>
