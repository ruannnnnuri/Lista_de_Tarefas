<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lista_de_Tarefas.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20,0,20,0" HorizontalOptions="Center">
            <Grid HorizontalOptions="Center" ColumnSpacing="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.ColumnSpan="3" Grid.Row="0" Text="Minhas Tarefas" FontAttributes="Bold" FontSize="30" HorizontalOptions="Center"/>
                <Entry Grid.ColumnSpan="2" Grid.Row="1" x:Name="entryTarefa" Placeholder="Adicione uma tarefa"/>
                <Button Grid.Column="2" Grid.Row="1" x:Name="btAdicionar" Text="Adicionar" Clicked="btAdicionar_Clicked"/>
                <VerticalStackLayout Grid.ColumnSpan="3" Grid.Row="2">
                    <!--Adiciona tarefas pelo back-end-->
                </VerticalStackLayout>
            </Grid>

            <Label x:Name="lbContagem" Text="0 de 0 tarefas concluídas" HorizontalOptions="Center" TranslationY="690"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
